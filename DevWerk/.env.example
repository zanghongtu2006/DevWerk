# =============================================================================
# DevWerk Backend Environment Template
# =============================================================================
# The IDE plugin does not select models. Backend agents choose API profiles here.
#
# Real secrets should be set as OS environment variables or local untracked
# .env files. Never commit real tokens.
# =============================================================================

APP_ENV=development
HOST=0.0.0.0
PORT=8000
RELOAD=false
LOG_LEVEL=debug
LOG_FORMAT=%(asctime)s %(levelname)s [%(name)s] %(message)s
LOG_FILE_ENABLED=true
LOG_DIR=./data/logs
LOG_FILE_NAME=devwerk.log
LOG_RETENTION_DAYS=30
UVICORN_ACCESS_LOG=true

# Local usage accounting. SQLite is intentionally local and lightweight.
DEVWERK_USAGE_TRACKING=true
DEVWERK_DB_PATH=./data/devwerk.db

# Kanban workflow supervision. Tasks with lost workers are recovered from the
# persisted request body; expired client/user boundaries terminate as failed.
WORKFLOW_SUPERVISOR_ENABLED=true
WORKFLOW_SUPERVISOR_INTERVAL_SECONDS=5
WORKFLOW_QUEUED_RECOVERY_SECONDS=15
WORKFLOW_EXECUTION_TIMEOUT_SECONDS=1800
WORKFLOW_CLIENT_TIMEOUT_SECONDS=1800
WORKFLOW_USER_TIMEOUT_SECONDS=86400

# Durable task/session logs and memory snapshots.
# Defaults to ./data/sessions next to DEVWERK_DB_PATH.
# DEVWERK_SESSION_DIR=./data/sessions

# Structured LLM catalog and routing map.
# Copy config/llm.example.json to config/llm.json for local secrets.
DEVWERK_LLM_CONFIG_PATH=./config/llm.json

# Legacy defaults used only when DEVWERK_LLM_CONFIG_PATH/JSON are absent.
DEVWERK_THINKING_MODE=balanced
DEVWERK_TEMPERATURE=0.2
DEVWERK_TOP_P=
DEVWERK_MAX_TOKENS=4096
# Keep LLM HTTP clients off OS proxy variables by default. Set true only when
# the provider must be reached through HTTP_PROXY/HTTPS_PROXY.
DEVWERK_TRUST_ENV_PROXY=false

# -----------------------------------------------------------------------------
# Agent routing
# -----------------------------------------------------------------------------
# Supported API profiles: anthropic | openai | ollama
# Defaults are Anthropic-compatible because MiniMax can be used through the
# Claude Code compatible Anthropic endpoint.

DEVWERK_DEFAULT_API=anthropic
DEVWERK_DEFAULT_AGENT=coder

# Optional per-agent overrides. Leave blank to use DEVWERK_DEFAULT_API.
# DEVWERK_CODER_API=anthropic
# DEVWERK_PLANNER_API=openai
# DEVWERK_EXECUTOR_API=anthropic

# Backward-compatible selector. If set, overrides DEVWERK_DEFAULT_API.
# LLM_PROVIDER=anthropic

# -----------------------------------------------------------------------------
# Anthropic-compatible profile (MiniMax / Claude Code compatible)
# -----------------------------------------------------------------------------
# Claude Code compatible example:
#   ANTHROPIC_AUTH_TOKEN=API_TOKEN
#   ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
#   ANTHROPIC_MODEL=M3
#   ANTHROPIC_DEFAULT_SONNET_MODEL=M3
#   ANTHROPIC_DEFAULT_HAIKU_MODEL=M3
#   ANTHROPIC_DEFAULT_OPUS_MODEL=M3
#   CLAUDE_CODE_SUBAGENT_MODEL=M3
#   CLAUDE_CODE_EFFORT_LEVEL=max
#   DISABLE_AUTOUPDATER=1

ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic
# ANTHROPIC_AUTH_TOKEN=        # set as real env var
ANTHROPIC_MODEL=M3
ANTHROPIC_DEFAULT_SONNET_MODEL=M3
ANTHROPIC_DEFAULT_HAIKU_MODEL=M3
ANTHROPIC_DEFAULT_OPUS_MODEL=M3
CLAUDE_CODE_SUBAGENT_MODEL=M3
CLAUDE_CODE_EFFORT_LEVEL=max
ANTHROPIC_TIMEOUT=180
DISABLE_AUTOUPDATER=1

# -----------------------------------------------------------------------------
# OpenAI-compatible profile
# -----------------------------------------------------------------------------
# Use this for OpenAI or any gateway that implements /v1/chat/completions.

OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=             # set as real env var
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=180

# -----------------------------------------------------------------------------
# Ollama local profile
# -----------------------------------------------------------------------------

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:32b
OLLAMA_TIMEOUT=180
OLLAMA_ENABLE_SCHEMA=true
