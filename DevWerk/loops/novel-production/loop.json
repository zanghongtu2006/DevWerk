    "workflow": {
      "schema_version":"devwerk.workflow.v1",
      "name":"小说章节创作与返修有向图",
      "description":"每个章节 Task 复用同一有向图；审核可定向回退到基线、提要或同一 Writer。",
      "entry":"foundation",
      "terminals":{"success":"done","failure":"failed"},
      "columns":[
        {
          "key":"foundation","name":"建立或核验创作基线",
          "instruction":"你是创作基线 Agent。读取 Task 输入和项目现有文件。第01章动笔前必须创建并交叉核验 guides/outline.md、scene.md、dialogue.md、symbols.md、pacing.md、supporting_characters.md、emotion.md、anti_ai_style.md、body.md、era.md；总纲先于其余手册。后续章节只核验并读取同一冻结基线，不得擅自改写。手册必须覆盖人物、冲突、世界、伏笔、风格与一致性。Task input 的 chapter_target_characters 只是写作目标，不是验收上下界；只有 chapter_max_characters 是硬性长度上限，任何手册不得擅自增加更窄的字数窗口、百分比容差或由此产生的退回规则。用 project.files 工具留下证据。基线齐备且一致时 complete foundation_ready；可在本阶段解决的问题 complete foundation_needs_revision 让图回到本 Column；无法执行时 complete execution_failed 并写明原因。",
          "executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.files.measure"]},
          "context":{"include_project":true,"include_task":true,"upstream_outputs":[],"artifact_globs":["guides/*.md"]},
          "input_contract":{},"output_contract":{"type":"object","additionalProperties":true},
          "transitions":[{"outcome":"foundation_ready","target":"recap"},{"outcome":"foundation_needs_revision","target":"foundation"},{"outcome":"execution_failed","target":"failed"}],
          "metadata":{"purpose":"冻结十份创作手册；后续章节核验同一 revision","derives_agent":true,"writable_paths":["guides/*.md"]}
        },
        {
          "key":"recap","name":"读取历史并生成前情提要",
          "instruction":"你是独立提要 Agent。完整读取十份 guides 手册和此前所有已验收 chapters 正文，不能只读旧提要。第01章生成开篇背景提要。将当前章约100字提要写入 Task input 指定的 summary_path，并在输出列出实际读取的历史文件及提要 artifact。提要与历史一致时 complete recap_ready；提要需重做时 complete recap_needs_revision；发现 guides 自相矛盾时 complete foundation_invalid；无法执行时 complete execution_failed。",
          "executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.files.measure"]},
          "context":{"include_project":true,"include_task":true,"upstream_outputs":["foundation"],"artifact_globs":["guides/*.md","chapters/*.md","summaries/*.md"]},
          "input_contract":{},"output_contract":{"type":"object","additionalProperties":true},
          "transitions":[{"outcome":"recap_ready","target":"write"},{"outcome":"recap_needs_revision","target":"recap"},{"outcome":"foundation_invalid","target":"foundation"},{"outcome":"execution_failed","target":"failed"}],
          "metadata":{"purpose":"基于全部已验收正文生成本章提要","derives_agent":true,"writable_paths":[{"$ref":"/input/task/input/summary_path"}]}
        },
        {
          "key":"write","name":"写作或根据审核意见返修",
          "instruction":"你是本章节的 Writer。完整读取十份 guides 手册、本章 summaries 提要、此前全部已验收正文、当前正文和 reviews 中与本章有关的最新意见。首次写作生成连续、有冲突和伏笔的正文；返修时必须修改现有正文并逐项处理 Reviewer 意见，禁止从零盲写。正文目标和宽松上限来自 Task input，禁止重复填充。写入 body_path 后 complete draft_ready；发现冻结基线根本冲突时 complete foundation_invalid；无法执行时 complete execution_failed。",
          "executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.files.measure"]},
          "context":{"include_project":true,"include_task":true,"upstream_outputs":["foundation","recap","review"],"artifact_globs":["guides/*.md","chapters/*.md","summaries/*.md","reviews/*.md"]},
          "input_contract":{},"output_contract":{"type":"object","additionalProperties":true},
          "transitions":[{"outcome":"draft_ready","target":"review"},{"outcome":"foundation_invalid","target":"foundation"},{"outcome":"execution_failed","target":"failed"}],
          "metadata":{"purpose":"同一 Writer 会话持续写作和返修","derives_agent":true,"agent_session_key":"chapter_writer","writable_paths":[{"$ref":"/input/task/input/body_path"}]}
        },
        {
          "key":"review","name":"独立审查章节",
          "instruction":"你是独立 Reviewer，不得修改正文。读取十份 guides、当前提要、当前正文、此前全部章节和已有 review。检查 chapter_max_characters 硬性上限、人物与设定连续性、冲突伏笔、场景对话节奏情感身体时代细节以及去AI味规则；chapter_target_characters 只用于描述目标，不得仅因偏离目标而退回，也不得执行手册擅自增加的更窄字数窗口。将结构化意见写入 Task input 的 review_path，包含问题类别、证据位置、违反手册、修改要求和当前正文哈希。完全通过时 complete accepted；正文问题 complete chapter_rejected；提要错误 complete recap_rejected；基线错误 complete foundation_invalid；无法执行时 complete execution_failed。",
          "executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.files.measure"]},
          "context":{"include_project":true,"include_task":true,"upstream_outputs":["foundation","recap","write"],"artifact_globs":["guides/*.md","chapters/*.md","summaries/*.md","reviews/*.md"]},
          "input_contract":{},"output_contract":{"type":"object","additionalProperties":true},
          "transitions":[{"outcome":"accepted","target":"deliver"},{"outcome":"chapter_rejected","target":"write"},{"outcome":"recap_rejected","target":"recap"},{"outcome":"foundation_invalid","target":"foundation"},{"outcome":"execution_failed","target":"failed"}],
          "metadata":{"purpose":"独立验收并定向反馈，不修改正文","derives_agent":true,"writable_paths":[{"$ref":"/input/task/input/review_path"}]}
        },
        {
          "key":"deliver","name":"交付章节与最终验收",
          "instruction":"你是交付 Agent。读取 review 文件，确认 accepted 绑定的正文哈希与当前 body_path 一致，并核验 summary_path 和正文非空。若不匹配 complete delivery_rejected 返回 Reviewer。普通章节记录交付证据后 complete delivered。若 Task input is_final_chapter=true，还必须核验恰好十份章节和十份提要、十份 guides、全部 review 接受，生成完整 INDEX.md 和 FINAL_ACCEPTANCE.md 后才能 complete delivered。无法执行时 complete execution_failed。",
          "executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.files.measure"]},
          "context":{"include_project":true,"include_task":true,"upstream_outputs":["review"],"artifact_globs":["guides/*.md","chapters/*.md","summaries/*.md","reviews/*.md","INDEX.md","FINAL_ACCEPTANCE.md"]},
          "input_contract":{},"output_contract":{"type":"object","additionalProperties":true},
          "transitions":[{"outcome":"delivered","target":"done"},{"outcome":"delivery_rejected","target":"review"},{"outcome":"execution_failed","target":"failed"}],
          "metadata":{"purpose":"只交付 Reviewer 已接受版本；第十章完成项目验收","derives_agent":true,"writable_paths":["INDEX.md","FINAL_ACCEPTANCE.md"]}
        }
      ]
    },
