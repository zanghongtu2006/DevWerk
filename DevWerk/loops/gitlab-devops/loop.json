{
  "schema_version": "devwerk.loop.bundle.v1",
  "parameter_schema": {
    "type": "object",
    "required": ["product_name", "gitlab_repository"],
    "properties": {
      "product_name": {"type": "string", "minLength": 1},
      "gitlab_repository": {"type": "string", "minLength": 1}
    },
    "additionalProperties": false
  },
  "bundle": {
    "defaults": {},
    "workflow_plan": {
      "schema_version": "devwerk.workflow-plan.v1",
      "intent_summary": "把用户明确确认的产品需求交付为经过构建、测试、审查和 GitLab CI 验证的软件。",
      "completion_definition": "设计文档、实现、构建测试证据、独立审查、GitLab 分支/MR/CI 证据和最终验收均完整，Task 到达 done。",
      "flow_unit": "一个具备明确验收标准的软件交付范围。",
      "lifecycle_summary": "确认冻结需求后完成架构设计、实现、自检、独立审查；审查或 CI 不通过时带着反馈返回原开发会话。",
      "entry_meaning": "需求已经过充分用户沟通并明确确认。",
      "terminal_meaning": "done 表示交付验收；failed 表示明确执行失败，可 reopen 原 Task。",
      "task_contract": {
        "input_schema": {
          "type": "object",
          "required": ["requirements_path", "requirements_confirmed"],
          "properties": {
            "requirements_path": {"type": "string", "minLength": 1},
            "requirements_confirmed": {"const": true}
          },
          "additionalProperties": false
        },
        "required_context": ["Project Loop bindings", "冻结需求文件", "项目源码"],
        "expected_outputs": ["设计文档", "源码", "测试证据", "独立审查", "GitLab MR 与 CI 证据", "最终验收"],
        "acceptance_contract": ["冻结需求全部满足", "构建测试通过", "独立审查接受", "GitLab CI 成功"]
      },
      "columns": [
        {"key":"design","responsibility":"基于冻结需求完成架构、接口、数据和交付设计。","execution_mode":"agent","entry_evidence":["用户确认的需求文件","验收标准","GitLab 工程信息"],"exit_evidence":["版本化设计文档"],"context_boundary":"不得猜测或修改冻结需求。","review_or_rework_role":"发现关键需求缺口时返回需求沟通而不是继续开发。"},
        {"key":"development","responsibility":"由持续 Developer、真实验证者和独立 Reviewer 在同一 Workcell 内实现、验证、审查并定向返修。","execution_mode":"workcell","entry_evidence":["冻结需求","设计文档","审查、CI或验收反馈"],"exit_evidence":["源码与变更说明","真实构建测试证据","结构化独立审查"],"context_boundary":"Developer 只修改当前范围；Verifier 真实执行命令；Reviewer 不直接修改实现；反馈通过定向 Handoff 传递。","review_or_rework_role":"验证或审查失败在 Workcell 内返回同一 Developer session；外层 CI/验收退回时复用 Task 生命周期 Developer。"},
        {"key":"gitlab","responsibility":"执行 GitLab 分支、提交、MR 与 CI 工作流。","execution_mode":"agent","entry_evidence":["已审查实现","GitLab repository"],"exit_evidence":["commit、MR和CI证据"],"context_boundary":"使用项目声明的 GitLab 工作流。","review_or_rework_role":"CI失败携带日志返回 implement。"},
        {"key":"accept","responsibility":"根据冻结验收标准完成最终验收。","execution_mode":"agent","entry_evidence":["需求基线","审查接受","CI成功"],"exit_evidence":["最终验收报告"],"context_boundary":"不得降低用户验收标准。","review_or_rework_role":"验收不通过返回 implement。"}
      ],
      "lifecycle_walkthrough":[
        {"column_key":"design","receives":["已确认需求"],"action":"完成架构和交付设计。","produces":["设计文档"],"completion_evidence":["设计覆盖验收标准"],"outcome":"designed"},
        {"column_key":"development","receives":["冻结需求、设计以及既有反馈"],"action":"Developer 实现，Verifier 真实运行构建测试，Reviewer 独立审查；失败定向回到同一 Developer。","produces":["源码、验证证据和审查报告"],"completion_evidence":["真实命令通过且独立审查接受"],"outcome":"accepted"},
        {"column_key":"gitlab","receives":["已接受实现"],"action":"完成 GitLab 与 CI。","produces":["MR和CI证据"],"completion_evidence":["CI成功"],"outcome":"ci_passed"},
        {"column_key":"accept","receives":["全部交付证据"],"action":"执行最终验收。","produces":["验收报告"],"completion_evidence":["全部标准通过"],"outcome":"delivered"}
      ],
      "wip_group":"software_delivery","wip_limit":1,
      "wip_decision":"同一产品交付范围串行经过设计、实现、验证和交付。",
      "concurrency_groups":[],"serialization_reasons":["审查和CI反馈必须返回同一开发上下文。"],
      "progress_evidence":["设计、提交、构建、测试、审查、MR和CI事件"],
      "review_points":["架构设计","独立代码审查","CI","最终验收"],
      "intervention_conditions":["发现未确认需求","构建或CI失败","执行失败"],
      "self_check":{"every_task_can_start_at_entry":true,"every_column_applies_to_every_task":true,"columns_are_process_stages_not_work_slices":true,"tasks_are_independently_reviewable":true,"context_handoffs_are_explicit":true,"concurrency_conflicts_are_declared":true,"terminal_and_rework_paths_are_explicit":true}
    },
    "workflow": {
      "schema_version":"devwerk.workflow.v1","name":"GitLab 软件交付有向图","description":"需求确认后的软件交付流程；审查、验证和CI均可带反馈回到同一开发会话。","entry":"design","terminals":{"success":"done","failure":"failed"},
      "columns":[
        {"key":"design","name":"架构设计与文档落地","instruction":"读取 project.loop.bindings 中的产品与 GitLab repository，并按需读取 Task input 指定且已确认的 requirements_path。完成架构、接口、数据、测试和GitLab交付设计并写入 docs。若发现关键需求未确认，complete requirement_gap；设计可执行时 complete designed；执行失败 complete execution_failed。","executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write"]},"context":{"include_project":true,"include_task":true,"upstream_outputs":[],"artifact_globs":[]},"input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"outcome":"designed","target":"development"},{"outcome":"requirement_gap","target":"failed"},{"outcome":"execution_failed","target":"failed"}],"metadata":{"purpose":"从冻结需求形成可执行设计","derives_agent":true}},
        {"key":"development","name":"持续开发、验证与独立审查 Workcell","instruction":"外层 Column 只接收 Workcell terminal；实现、真实验证和独立审查的机械路由由声明式内层图完成。","executor":{"kind":"workcell","entry":"implement","participants":[{"key":"developer","kind":"agent","lifecycle":"task","instruction":"你是持续 Developer。读取冻结需求、设计、当前源码以及定向 Handoff；按需 list/search/read，不预加载整个仓库。首次实现或定向修改，禁止无理由推倒重来。完成 emit implemented；需求基线缺失 emit requirement_gap；无法执行 emit execution_failed。","capabilities":["project.files.list","project.files.read","project.files.search","project.files.write","project.command.run"],"context":{"include_project":true,"include_task":true,"upstream_outputs":[],"artifact_globs":[],"memory":[]}},{"key":"verifier","kind":"agent","lifecycle":"column_visit","instruction":"你是验证者。真实运行项目构建和测试命令并记录退出码与错误，不用文字声称通过。全部通过 emit verified；代码问题 emit verification_failed 并定向反馈 Developer；环境无法执行 emit execution_failed。","capabilities":["project.files.list","project.files.read","project.files.write","project.command.run"],"context":{"include_project":true,"include_task":true,"upstream_outputs":[],"artifact_globs":[],"memory":[]}},{"key":"reviewer","kind":"agent","lifecycle":"column_visit","instruction":"你是独立 Reviewer，不直接修改实现。对照冻结需求、设计、代码和真实测试证据审查并写结构化报告。通过 emit accepted；代码问题 emit changes_requested 并定向反馈 Developer；需求缺口 emit requirement_gap；无法执行 emit execution_failed。","capabilities":["project.files.list","project.files.read","project.files.search","project.files.write"],"context":{"include_project":true,"include_task":true,"upstream_outputs":[],"artifact_globs":[],"memory":[]}}],"states":[{"key":"implement","participant":"developer","instruction":"实现或依据定向反馈修改当前交付。","input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"signal":"implemented","target":"verify","receivers":["verifier"]},{"signal":"requirement_gap","target":"requirement_gap","receivers":[]},{"signal":"execution_failed","target":"execution_failed","receivers":[]}]},{"key":"verify","participant":"verifier","instruction":"真实执行构建与测试。","input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"signal":"verified","target":"review","receivers":["reviewer"]},{"signal":"verification_failed","target":"implement","receivers":["developer"]},{"signal":"execution_failed","target":"execution_failed","receivers":[]}]},{"key":"review","participant":"reviewer","instruction":"独立审查当前实现与验证证据。","input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"signal":"accepted","target":"accepted","receivers":["developer"]},{"signal":"changes_requested","target":"implement","receivers":["developer"]},{"signal":"requirement_gap","target":"requirement_gap","receivers":[]},{"signal":"execution_failed","target":"execution_failed","receivers":[]}]}],"terminals":[{"key":"accepted","outcome":"accepted"},{"key":"requirement_gap","outcome":"requirement_gap"},{"key":"execution_failed","outcome":"execution_failed"}]},"context":{"include_project":true,"include_task":true,"upstream_outputs":["design","gitlab","accept"],"artifact_globs":[],"memory":[]},"input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"outcome":"accepted","target":"gitlab"},{"outcome":"requirement_gap","target":"failed"},{"outcome":"execution_failed","target":"failed"}],"metadata":{"purpose":"同一 Developer 与独立验证审查参与者闭环"}},
        {"key":"gitlab","name":"GitLab 与 CI","instruction":"使用 project.loop.bindings.gitlab_repository 和项目既定工作流完成分支、提交、MR及CI检查，记录实体ID和日志。CI通过 complete ci_passed；CI或合并前问题 complete ci_failed 返回开发；执行失败 complete execution_failed。","executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.command.run"]},"context":{"include_project":true,"include_task":true,"upstream_outputs":["development"],"artifact_globs":[]},"input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"outcome":"ci_passed","target":"accept"},{"outcome":"ci_failed","target":"development"},{"outcome":"execution_failed","target":"failed"}],"metadata":{"purpose":"完成GitLab提交、MR和CI闭环","derives_agent":true}},
        {"key":"accept","name":"最终验收","instruction":"按需读取 Task input 中 requirements_path 的冻结验收标准，检查设计、实现、测试、审查与CI证据，写 FINAL_ACCEPTANCE.md。全部通过 complete delivered；产品问题 complete acceptance_failed 返回开发；执行失败 complete execution_failed。","executor":{"kind":"agent","capabilities":["project.files.list","project.files.read","project.files.write","project.command.run"]},"context":{"include_project":true,"include_task":true,"upstream_outputs":["design","development","gitlab"],"artifact_globs":[]},"input_contract":{},"output_contract":{"type":"object","additionalProperties":true},"transitions":[{"outcome":"delivered","target":"done"},{"outcome":"acceptance_failed","target":"development"},{"outcome":"execution_failed","target":"failed"}],"metadata":{"purpose":"依据冻结需求完成最终验收","derives_agent":true}}
      ]
    }
  }
}
