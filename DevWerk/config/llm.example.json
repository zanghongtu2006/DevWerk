{
  "providers": {
    "minimax": {
      "protocol": "anthropic",
      "base_url": "https://api.minimaxi.com/anthropic",
      "api_key_env": "DEVWERK_MINIMAX_API_KEY"
    },
    "deepseek": {
      "protocol": "openai",
      "base_url": "https://api.deepseek.com/v1",
      "api_key_env": "DEVWERK_DEEPSEEK_API_KEY"
    },
    "openai": {
      "protocol": "openai",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "DEVWERK_OPENAI_API_KEY"
    },
    "ollama": {
      "protocol": "ollama",
      "base_url": "http://127.0.0.1:11434"
    }
  },
  "models": {
    "main": {
      "provider": "minimax",
      "model": "M3",
      "request_timeout_seconds": 600,
      "temperature": 0.2,
      "max_tokens": 65535,
      "thinking_mode": "max",
      "effort_level": "max"
    },
    "deepseek_chat": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "request_timeout_seconds": 600,
      "temperature": 0.2,
      "max_tokens": 65535,
      "thinking_mode": "balanced"
    },
    "openai_mini": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "request_timeout_seconds": 600,
      "temperature": 0.2,
      "max_tokens": 65535,
      "thinking_mode": "balanced"
    },
    "local": {
      "provider": "ollama",
      "model": "deepseek-r1:32b",
      "request_timeout_seconds": 600,
      "temperature": 0.4,
      "max_tokens": 65535,
      "thinking_mode": "local"
    }
  },
  "routes": {
    "conversation": "main",
    "column": "main",
    "default": "main"
  },
  "runtime": {
    "trust_env_proxy": false
  }
}
