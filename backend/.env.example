# =============================================================================
# DevWerk — Environment Variables Template
# =============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
#   cp .env.example .env
#
# IMPORTANT: .env is in .gitignore — real secrets go here, never committed.
#
# Environment loading order (high → low priority):
#   1. Real OS environment variables       (never overwritten)
#   2. .env                                (shared defaults, committed)
#   3. .env.development / .env.production  (local overrides, NOT committed)
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# Options: development | test | production
# Switches which .env.{name} side-car file is also loaded (see below).
APP_ENV=development

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Enable uvicorn --reload (useful in development, leave off in production).
RELOAD=false

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: ollama | openai | xai | gemini | minimax | minimax_overseas
LLM_PROVIDER=ollama

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:32b
OLLAMA_TIMEOUT=180
# Set to false if Ollama rejects JSON schema (some older models).
OLLAMA_ENABLE_SCHEMA=true

# ── OpenAI ───────────────────────────────────────────────────────────────────
# API key — SET AS A REAL ENVIRONMENT VARIABLE in production.
#   Linux/macOS:  export OPENAI_API_KEY=sk-...
#   Windows CMD:  set OPENAI_API_KEY=sk-...
#   Windows PS:   $env:OPENAI_API_KEY="sk-..."
# DO NOT put the real key in a .env file that could be committed.
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=       # ← set as real env var, NOT here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=180

# ── xAI (Grok) ───────────────────────────────────────────────────────────────
XAI_BASE_URL=https://api.x.ai/v1
# XAI_API_KEY=          # ← set as real env var
XAI_MODEL=grok-3
XAI_TIMEOUT=180

# ── Google Gemini ──────────────────────────────────────────────────────────────
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GEMINI_API_KEY=       # ← set as real env var (GOOGLE_API_KEY also works)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=180

# ── MiniMax (China mainland) ──────────────────────────────────────────────────
# Use LLM_PROVIDER=minimax
MINIMAX_BASE_URL=https://api.minimax.chat/v1
# MINIMAX_API_KEY=                  # ← set as real env var, never commit
MINIMAX_MODEL=MiniMax-Text-01
MINIMAX_TIMEOUT=180

# ── MiniMax (Overseas) ───────────────────────────────────────────────────────
# Use LLM_PROVIDER=minimax_overseas
MINIMAX_OVERSEAS_BASE_URL=https://api.minimaxi.chat/v1
# MINIMAX_OVERSEAS_API_KEY=        # ← set as real env var, never commit
MINIMAX_OVERSEAS_MODEL=MiniMax-Text-01
MINIMAX_OVERSEAS_TIMEOUT=180

# =============================================================================
# Environment-specific override files (NOT committed to git):
#
#   .env.development   — overrides for local dev (ollama defaults above)
#   .env.test          — overrides for CI / test runs
#   .env.production    — overrides for production deploy
#
# Example .env.development:
#   APP_ENV=development
#   OLLAMA_BASE_URL=http://127.0.0.1:11434
#   OLLAMA_MODEL=qwen2.5-coder:32b
#
# Example .env.production:
#   APP_ENV=production
#   LLM_PROVIDER=openai
#   OPENAI_API_KEY is read from the real OS env, not this file
# =============================================================================
